---
/**
 * The screenshots, as a scroll-snap strip below the hero.
 *
 * A strip rather than an auto-advancing carousel: nothing moves on its own, the
 * images are reachable by trackpad, touch and keyboard, and the arrows are the
 * only scripted part. Without JavaScript the strip is still a strip - it scrolls.
 */

interface Slide {
  src: string;
  alt: string;
  caption: string;
}

const slides: Slide[] = [
  {
    src: '/media/ui.webp',
    alt: 'DragonFruit in Prepare mode: a supported model on a dark grid, the model list on the left, and the plate\'s print estimate in the corner.',
    caption:
      'The workspace — four modes along the top, the model list on the left, the plate in front of you and its own estimate in the corner. Nothing else in the way.',
  },
  {
    src: '/media/support-studio.webp',
    alt: "Support mode with Support Studio open: the model's unsupported regions highlighted, and the support settings panel on the right.",
    caption:
      'Support Studio, with island scanning on — the highlight is where the model has nothing under it, and the panel is where the tree is shaped.',
  },
  {
    src: '/media/multi-plate.webp',
    alt: 'Four plates laid out in one scene in Prepare mode, each labelled, with a model on the first.',
    caption: 'Multi-plate — four plates in one scene, with the model list switching between them.',
  },
  {
    src: '/media/slicing.webp',
    alt: 'A Slicing Finished dialog over the Printing view, giving the path of the written .ctb file and a slicing time of 1.01 seconds.',
    caption: 'High-speed slicing — the plate sliced and written as a .ctb in 1.01 seconds.',
  },
  {
    src: '/media/3daa.webp',
    alt: 'Printing mode: the printed model with the current layer highlighted, beside a layer preview whose mask has soft grey edges rather than a hard black-and-white one.',
    caption:
      '3D anti-aliasing — the layer mask carries grey levels rather than a hard edge, which is what smooths a curve and takes the stair-stepping out of a slope.',
  },
];
---

<section class="showcase" aria-label="Screenshots" data-carousel>
  <div class="shell">
    <ul class="showcase__track" data-carousel-track tabindex="0">
      {
        slides.map((slide, index) => (
          <li class="slide">
            <figure class="slide__figure">
              <img
                src={slide.src}
                alt={slide.alt}
                width="1600"
                height="870"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption class="mono muted">{slide.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="showcase__controls">
      <button class="showcase__button" type="button" data-carousel-prev aria-label="Previous screenshot">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5.5 8.5 12l6.5 6.5"></path>
        </svg>
      </button>
      <span class="showcase__count mono" data-carousel-count aria-hidden="true"></span>
      <button class="showcase__button" type="button" data-carousel-next aria-label="Next screenshot">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5.5 15.5 12 9 18.5"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  // One strip, so the lookups are direct. The arrows walk a slide at a time and
  // switch themselves off at either end; if the strip does not scroll (a wide
  // enough viewport, or one slide) they stay hidden rather than pretending.
  const root = document.querySelector('[data-carousel]');
  const track = root?.querySelector<HTMLElement>('[data-carousel-track]');
  const prev = root?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = root?.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (root && track && prev && next) {
    const step = () => {
      const slide = track.querySelector('li');
      const gap = parseFloat(getComputedStyle(track).columnGap || '16');
      return slide ? slide.getBoundingClientRect().width + gap : track.clientWidth;
    };

    const count = root.querySelector<HTMLElement>('[data-carousel-count]');

    const update = () => {
      const scrollable = track.scrollWidth - track.clientWidth > 8;
      root.toggleAttribute('data-scrollable', scrollable);
      prev.disabled = !scrollable || track.scrollLeft <= 4;
      next.disabled = !scrollable || track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;

      if (count) {
        const total = track.querySelectorAll('li').length;
        const current = Math.min(total, Math.round(track.scrollLeft / track.clientWidth) + 1);
        count.textContent = `${current} / ${total}`;
      }
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  .showcase {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem);
  }

  .showcase__track {
    display: flex;
    /* One image at a time: each slide is the whole viewport, and with no gap the
       next one cannot peek in at the side. */
    gap: 0;
    margin: 0;
    padding: 0.25rem 0 0.75rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    /* The strip is the scroll affordance; a bar under it would be furniture. */
    scrollbar-width: none;
  }

  .showcase__track::-webkit-scrollbar {
    display: none;
  }

  .showcase__track:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .slide__figure {
    margin: 0;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 0.4rem;
    overflow: hidden;
  }

  .slide__figure img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: calc(var(--radius-lg) - 5px);
  }

  .slide__figure figcaption {
    padding: 0.6rem 0.5rem 0.3rem;
    font-size: 0.75rem;
  }

  /* Nothing to press without a script, or when the strip is not scrollable. */
  .showcase__controls {
    display: none;
  }

  .showcase[data-scrollable] .showcase__controls {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .showcase__count {
    align-self: center;
    font-size: 0.75rem;
    color: var(--muted);
    /* The arrows are the control; the numbers are a readout, so they do not
       widen or shift as the count changes. */
    min-inline-size: 3.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .showcase__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease), background-color 0.16s var(--ease);
  }

  .showcase__button:hover:not(:disabled) {
    color: var(--ink);
    border-color: var(--border-strong);
    background: var(--bg-inset);
  }

  .showcase__button:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>
